# -----------------------------------------------------------------------------
# File Extraction Service — environment configuration
# All runtime settings use the FTMD_ prefix (see fastapi_mcp_template/config.py).
# Copy to .env and adjust. Do NOT commit your real .env.
# -----------------------------------------------------------------------------

# Server
FTMD_HOST=0.0.0.0
FTMD_PORT=8000
FTMD_DEBUG=false
FTMD_RELOAD=false
FTMD_LOG_LEVEL=INFO

# Tool loading
# Absolute path is auto-detected; override only if needed.
# FTMD_TOOLS_DIRECTORY=/app/tools
# Runtime allow-list of tools to load (comma-separated). Empty = load all.
FTMD_ENABLED_TOOLS=file_converter,url_fetcher,text_processor

# Security
# If set, tool-execution and admin endpoints require this key, sent as
# "X-API-Key: <key>" or "Authorization: Bearer <key>".
FTMD_API_KEY=
# CORS: "*" (no credentials) or a comma-separated origin list. With a list,
# requests from any other browser origin are rejected (403), which also protects
# a server on your own machine against DNS-rebinding attacks from web pages.
FTMD_CORS_ORIGINS=*
FTMD_CORS_ALLOW_CREDENTIALS=false

# MCP sessions
FTMD_SESSION_TTL_SECONDS=3600          # idle time before a session expires (0 = never)
FTMD_MAX_SESSIONS=10000

# Extraction limits
FTMD_MAX_UPLOAD_BYTES=52428800        # 50 MiB
# Largest HTTP request body; 0 = derived from FTMD_MAX_UPLOAD_BYTES (+ base64 overhead)
FTMD_MAX_REQUEST_BYTES=0
FTMD_OCR_MAX_PAGES=50                  # 0 = no limit
FTMD_OCR_LANGUAGES=eng                 # tesseract lang(s), e.g. deu+eng
# Who reads a scanned page first when the LLM integration below is enabled:
#   vision_first = the vision LLM (best quality); Tesseract is the fallback
#   ocr_first    = Tesseract (free); the LLM only gets pages Tesseract cannot read
FTMD_OCR_STRATEGY=vision_first
FTMD_VISION_MAX_TOKENS=4000
FTMD_VISION_MAX_CALLS_PER_REQUEST=0    # cap vision calls per request (0 = no cap); pages beyond it use Tesseract

# Observability
FTMD_METRICS_ENABLED=true              # expose /metrics (counters, vision usage, cost)

# Background jobs (in-process; not durable across restarts)
FTMD_JOB_MAX_CONCURRENT=4
FTMD_JOB_MAX_ENTRIES=1000
FTMD_JOB_TTL_SECONDS=3600

# URL fetching / SSRF protection
FTMD_BLOCK_PRIVATE_URLS=true
FTMD_URL_MAX_REDIRECTS=5
FTMD_URL_MAX_BYTES=10485760            # 10 MiB

# Result caching (content-hash keyed)
FTMD_CACHE_ENABLED=true
FTMD_CACHE_MAX_ENTRIES=128

# Optional LLM vision for scanned documents and images.
# Traditional OCR (tesseract) works WITHOUT any of these. With the LLM enabled,
# scanned pages are read by the vision model first (see FTMD_OCR_STRATEGY).
# Each page is one vision call: with a paid API, bound the cost with
# FTMD_OCR_MAX_PAGES / FTMD_VISION_MAX_CALLS_PER_REQUEST or use ocr_first.
FTMD_MARKITDOWN_ENABLE_LLM=false
FTMD_OPENAI_API_KEY=
FTMD_OPENAI_MODEL=gpt-4o
# FTMD_OPENAI_BASE_URL=https://your-resource.openai.azure.com/   # Azure/custom endpoints

# Self-hosted OpenAI-compatible server (LM Studio, Ollama, vLLM, ...): set the
# endpoint and model; no API key is needed.
# FTMD_MARKITDOWN_ENABLE_LLM=true
# FTMD_OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# FTMD_OPENAI_MODEL=your-vision-model

# Build-time only (consumed by the Dockerfile, not the app at runtime):
# ENABLED_TOOLS=file_converter,url_fetcher,text_processor
# ENABLE_TESTS=false
