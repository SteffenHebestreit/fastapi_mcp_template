# -----------------------------------------------------------------------------
# File Extraction Service — environment configuration
# All runtime settings use the FTMD_ prefix (see fastapi_mcp_template/config.py).
# Copy to .env and adjust. Do NOT commit your real .env.
# -----------------------------------------------------------------------------

# Server
FTMD_HOST=0.0.0.0
FTMD_PORT=8000
FTMD_DEBUG=false
FTMD_RELOAD=false
FTMD_LOG_LEVEL=INFO

# Tool loading
# Absolute path is auto-detected; override only if needed.
# FTMD_TOOLS_DIRECTORY=/app/tools
# Runtime allow-list of tools to load (comma-separated). Empty = load all.
FTMD_ENABLED_TOOLS=file_converter,url_fetcher,text_processor

# Security
# If set, tool-execution and admin endpoints require this in the X-API-Key header.
FTMD_API_KEY=
# CORS: "*" (no credentials) or a comma-separated origin list.
FTMD_CORS_ORIGINS=*
FTMD_CORS_ALLOW_CREDENTIALS=false

# Extraction limits
FTMD_MAX_UPLOAD_BYTES=52428800        # 50 MiB
FTMD_OCR_MAX_PAGES=50                  # 0 = no limit
FTMD_OCR_LANGUAGES=eng                 # tesseract lang(s), e.g. eng+deu
FTMD_VISION_MAX_TOKENS=4000
FTMD_VISION_MAX_CALLS_PER_REQUEST=0    # cap paid vision calls per request (0 = no cap)

# Observability
FTMD_METRICS_ENABLED=true              # expose /metrics (counters, vision usage, cost)

# Background jobs (in-process; not durable across restarts)
FTMD_JOB_MAX_CONCURRENT=4
FTMD_JOB_MAX_ENTRIES=1000
FTMD_JOB_TTL_SECONDS=3600

# URL fetching / SSRF protection
FTMD_BLOCK_PRIVATE_URLS=true
FTMD_URL_MAX_REDIRECTS=5
FTMD_URL_MAX_BYTES=10485760            # 10 MiB

# Result caching (content-hash keyed)
FTMD_CACHE_ENABLED=true
FTMD_CACHE_MAX_ENTRIES=128

# Optional LLM vision OCR for scanned documents.
# Traditional OCR (tesseract) works WITHOUT any of these; the LLM is only a
# second-level fallback for hard pages.
FTMD_MARKITDOWN_ENABLE_LLM=false
FTMD_OPENAI_API_KEY=
FTMD_OPENAI_MODEL=gpt-4o
# FTMD_OPENAI_BASE_URL=https://your-resource.openai.azure.com/   # Azure/custom endpoints

# Build-time only (consumed by the Dockerfile, not the app at runtime):
# ENABLED_TOOLS=file_converter,url_fetcher,text_processor
# ENABLE_TESTS=false
